{
  "name": "xinlianxin-daily-progress",
  "productName": "薪连薪每日推进",
  "version": "3.1.0",
  "description": "薪连薪每日推进 AI增长助手（M4/Apple Silicon）",
  "main": "main.js",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.0.12"
  },
  "scripts": {
    "dist:mac": "electron-builder --mac dmg zip --arm64"
  },
  "build": {
    "appId": "com.xinlianxin.dailyprogress",
    "productName": "薪连薪每日推进",
    "asar": true,
    "files": ["**/*"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "identity": null
    },
    "dmg": {
      "title": "薪连薪每日推进 ${version}",
      "artifactName": "薪连薪每日推进_AI增长助手_v${version}_M4_ARM64.${ext}"
    },
    "artifactName": "薪连薪每日推进_AI增长助手_v${version}_M4_ARM64.${ext}"
  }
}
